{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Incidents": {
    "RetentionDays": 7
  },
  "Monitoring": {
    "CheckerIntervalMinutes":       1,
    "OrderDetectionWindowMinutes":  5
  }
}
