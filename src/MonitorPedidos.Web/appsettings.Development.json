{
  "DetailedErrors": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/monitor-pedidos-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "MaxExportLines": 100,
    "FilePath": "logs/monitor-pedidos-.log"
  },
  "Incidents": {
    "RetentionDays": 7
  },
  "Monitoring": {
    "CheckerIntervalMinutes":       1,
    "ApiCheckerIntervalMinutes":    1,
    "OrderDetectionWindowMinutes":  5,
    "BrandMonitorWindowSeconds":   15
  },
  "Salesforce": {
    "BaseUrl": "https://sandbox.salesforce.com/services/data/v58.0/"
  },
  "Multivende": {
    "BaseUrl": "https://api.multivende.com/apps/"
  },
  "Simulation": {
    "Enabled": true,
    "InsertIntervalMinutes": 5,
    "FailureProbability": 0.0,
    "NoOrdersMode": false
  }
}
