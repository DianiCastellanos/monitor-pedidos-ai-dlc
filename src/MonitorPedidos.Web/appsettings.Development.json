{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "MaxExportLines": 100,
    "FilePath": "logs/monitor-pedidos-.log"
  },
  "Incidents": {
    "RetentionDays": 7
  },
  "Monitoring": {
    "CheckerIntervalMinutes":       1,
