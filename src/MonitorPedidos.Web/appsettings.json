{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=MonitorPedidosDb;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/monitor-pedidos-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} | rid={RequestId}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Incidents": {
    "RetentionDays": 90
  },
  "Monitoring": {
    "CheckerIntervalMinutes":        5,
    "ApiCheckerIntervalMinutes":    10,
    "CheckerTimeoutMs":          30000,
    "OrderDetectionWindowMinutes":  30,
    "DbWarnLatencyMs":            1000,
    "DbCritTimeoutMs":            5000
  },
  "Salesforce": {
    "BaseUrl": ""
  },
  "Multivende": {
    "BaseUrl": ""
  },
  "Logging": {
    "MaxExportLines": 500,
    "FilePath": "logs/monitor-pedidos-.log"
  },
  "Simulation": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
