@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims
@using MonitorPedidos.Domain.Identity

<nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm sticky-top px-3 px-md-4">
    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold me-4" href="/dashboard">
        <span class="text-danger" style="font-size:1rem">&#9679;</span> MonitorPedidos AI
    </a>

    <div class="navbar-nav flex-row flex-wrap gap-1 me-auto">
        <NavLink href="/dashboard" class="nav-link px-2" ActiveClass="nav-link-active" Match="NavLinkMatch.All">Dashboard</NavLink>
        <NavLink href="/incidents" class="nav-link px-2" ActiveClass="nav-link-active">Historial</NavLink>
        <NavLink href="/incidents/weekly" class="nav-link px-2" ActiveClass="nav-link-active">Resumen Semanal</NavLink>
        <NavLink href="/noc" class="btn btn-sm btn-outline-dark ms-2 px-3" ActiveClass="btn-dark text-white" Match="NavLinkMatch.All">&#x1F5A5; Modo NOC</NavLink>
        @if (IsTecnico)
        {
            <NavLink href="/rules" class="nav-link px-2" ActiveClass="nav-link-active">Reglas</NavLink>
            <NavLink href="/logs"  class="nav-link px-2" ActiveClass="nav-link-active">Logs</NavLink>
        }
    </div>

    <div class="d-flex align-items-center gap-2 ms-3">
        <span class="badge bg-light text-secondary border" style="font-size:0.75rem">
            @(IsTecnico ? "Responsable Técnico" : "Analista Operativo")
        </span>
        <a href="/Identity/Logout" class="btn btn-sm btn-outline-secondary">Salir</a>
    </div>
</nav>

<main class="container-xxl px-3 px-md-4 py-3">
    @Body
</main>

@code {
    private bool IsTecnico { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        IsTecnico = auth.User.IsInRole(ApplicationRole.Names.Tecnico);
    }
}
