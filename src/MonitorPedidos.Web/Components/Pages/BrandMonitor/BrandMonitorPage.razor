@page "/brand-monitor"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject IBrandMonitorService BrandMonitorService

<PageTitle>Brand Monitor — MonitorPedidos</PageTitle>

<h2 class="mb-1">Brand Monitor</h2>
<p class="text-muted small mb-3">Pedidos pendientes por marca. Actualiza cada 10 minutos.</p>

@if (_loading)
{
    <p>Cargando...</p>
}
else if (!_snapshots.Any())
{
    <p class="text-muted">Sin datos de Brand Monitor aún. Espere el primer tick del scheduler.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Marca</th>
                <th class="text-center">Pendientes actuales</th>
                <th class="text-center">Hace 10 min</th>
                <th class="text-center">Cambio</th>
                <th class="text-center">Estado</th>
                <th class="text-muted small">Actualizado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _snapshots)
            {
                var hasHistory   = s.PendingCountPrevious.HasValue;
                var drop         = hasHistory ? s.PendingCountPrevious!.Value - s.PendingCountCurrent : (int?)null;
                var badgeColor   = hasHistory ? DropBadgeClass(drop)  : "secondary";
                var badgeLabel   = hasHistory ? DropBadgeLabel(drop)   : "Sin datos";
                <tr>
                    <td><strong>@s.Site</strong></td>
                    <td class="text-center">@(s.PendingCountCurrent < 0 ? "N/D" : s.PendingCountCurrent.ToString())</td>
                    <td class="text-center text-muted">@(hasHistory ? s.PendingCountPrevious!.Value.ToString() : "—")</td>
                    <td class="text-center">
                        @if (!hasHistory)
                        {
                            <span class="text-muted">—</span>
                        }
                        else if (drop > 0)
                        {
                            <span class="text-success">▼ @drop</span>
                        }
                        else if (drop < 0)
                        {
                            <span class="text-danger">▲ @(-drop)</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-center">
                        <span class="badge bg-@badgeColor fs-6">@badgeLabel</span>
                    </td>
                    <td class="text-muted small">@s.CheckedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
}

<button class="btn btn-outline-secondary btn-sm" @onclick="RefreshAsync" disabled="@_loading">↻ Actualizar</button>

@code {
    private IReadOnlyList<BrandSnapshot> _snapshots = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            await BrandMonitorService.SimulateAndRefreshAsync();
            _snapshots = await BrandMonitorService.GetCurrentSnapshotsAsync();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    // Badge derivado del drop real — s.Status no manda cuando hay histórico
    private static string DropBadgeClass(int? drop) => drop switch
    {
        > 0 => "success",
        < 0 => "danger",
        _   => "warning text-dark"
    };

    private static string DropBadgeLabel(int? drop) => drop switch
    {
        > 0 => "🟢 OK",
        < 0 => "🔴 Crítico",
        _   => "🟡 Moderado"
    };
}

@using MonitorPedidos.Domain.Dashboard
@using MonitorPedidos.Web.Services
