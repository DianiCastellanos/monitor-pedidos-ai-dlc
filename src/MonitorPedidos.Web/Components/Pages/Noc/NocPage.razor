@page "/noc"
@layout MonitorPedidos.Web.Components.Layout.NocLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using MonitorPedidos.Domain.Monitoring
@using MonitorPedidos.Domain.Dashboard
@using MonitorPedidos.Domain.Incidents
@using MonitorPedidos.Domain.Shared
@using MonitorPedidos.Domain.Alerts
@using MonitorPedidos.Web.Services
@inject LastCheckStore CheckStore
@inject IIncidentService IncidentService
@inject IBrandSnapshotRepository BrandSnapshotRepo
@inject IJobStatusSource JobSource
@inject AlertBroadcaster Broadcaster
@inject IJSRuntime JS

<style>
    @@keyframes pulse-critical {
        0%, 100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.0); border-color: #ef4444; }
        50%       { box-shadow: 0 0 18px 6px rgba(239,68,68,0.5); border-color: #ff6b6b; }
    }
    @@keyframes pulse-warn {
        0%, 100% { box-shadow: 0 0 0 0 rgba(234,179,8,0.0); }
        50%       { box-shadow: 0 0 14px 4px rgba(234,179,8,0.4); }
    }
    @@keyframes flash-incident {
        0%, 100% { background: rgba(239,68,68,0.08); }
        50%       { background: rgba(239,68,68,0.22); }
    }
    .noc-critical { animation: pulse-critical 1.4s ease-in-out infinite; }
    .noc-warn     { animation: pulse-warn 2s ease-in-out infinite; }
    .noc-incident-flash { animation: flash-incident 1.4s ease-in-out infinite; }
</style>

@* ── Barra de estado superior ── *@
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.2rem;
            border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:0.6rem;">
    <h3 class="mb-0 text-light" style="font-size:1.4rem; font-weight:600;">Estado del Sistema</h3>
    <div style="display:flex; gap:1.4rem; font-size:0.8rem; font-family:monospace;">
        @TimingChip("M3 APIs",      ModuleId.SalesforceApi)
        @TimingChip("M11 Jobs",     ModuleId.JobsMonitor)
        @TimingChip("M2 BD Ped.",   ModuleId.DbOrderChecker)
        @TimingChip("M4 BD Salud",  ModuleId.DbHealthChecker)
    </div>
</div>

@* ── Tarjetas M ── *@
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <NocCard Title="APIs Externas M3" Status="@GetApisStatus()" TestId="card-m3">
            <div style="padding:0.4rem 0; border-bottom:1px solid rgba(255,255,255,0.06);">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-weight:500;">Salesforce</span>
                    @ApiStatusBadge(ModuleId.SalesforceApi)
                </div>
                @{ var sfDetail = GetApiShortDetail(ModuleId.SalesforceApi); }
                @if (sfDetail is not null)
                {
                    <div style="color:#9ca3af; font-size:0.78rem; margin-top:0.15rem;">@sfDetail</div>
                }
            </div>
            <div style="padding:0.4rem 0;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-weight:500;">Multivende</span>
                    @ApiStatusBadge(ModuleId.MultivendeApi)
                </div>
                @{ var mvDetail = GetApiShortDetail(ModuleId.MultivendeApi); }
                @if (mvDetail is not null)
                {
                    <div style="color:#9ca3af; font-size:0.78rem; margin-top:0.15rem;">@mvDetail</div>
                }
            </div>
        </NocCard>
    </div>

    <div class="col-md-3">
        <NocCard Title="Jobs M11" Status="@GetModuleStatus(ModuleId.JobsMonitor)" TestId="card-m11">
            @if (_jobs is not null && _jobs.Count > 0)
            {
                foreach (var j in _jobs)
                {
                    <div style="display:flex; justify-content:space-between; align-items:center; padding:0.3rem 0; gap:0.5rem;">
                        <span style="font-weight:500;">@j.JobName</span>
                        <span style="color:@(j.IsRunning ? "#22c55e" : "#ef4444"); font-weight:700;">
                            @(j.IsRunning ? "Activo" : (j.FailureReason ?? "Inactivo"))
                        </span>
                    </div>
                }
            }
            else
            {
                <div style="color:#9ca3af;">Esperando datos...</div>
            }
        </NocCard>
    </div>

    <div class="col-md-3">
        <NocCard Title="BD Pedidos M2" Status="@GetModuleStatus(ModuleId.DbOrderChecker)" TestId="card-m2">
            <div style="color:#6b7280; font-size:0.75rem; margin-bottom:0.4rem;">Ventana: últimos 15 min</div>
            @if (_channels is not null)
            {
                foreach (var c in _channels)
                {
                    <div style="display:flex; justify-content:space-between; align-items:center; padding:0.3rem 0;">
                        <span style="font-weight:500;">@c.Name</span>
                        <span style="color:@(c.IsOk ? "#22c55e" : "#ef4444"); font-size:1.3rem; font-weight:700;">
                            @c.Count ped @(c.IsOk ? "" : "✗")
                        </span>
                    </div>
                }
            }
            else
            {
                <div style="color:#9ca3af;">Esperando datos...</div>
            }
        </NocCard>
    </div>

    <div class="col-md-3">
        <NocCard Title="BD Salud M4" Status="@GetModuleStatus(ModuleId.DbHealthChecker)" TestId="card-m4">
            <div style="font-size:1rem;">Latencia</div>
            <div style="font-size:2rem; font-weight:700; color:#22c55e;">@GetLatency()</div>
        </NocCard>
    </div>
</div>

@* ── Brand Monitor ── *@
<div class="mb-4">
    <BrandMonitorTable Snapshots="@_brandSnapshots"
                       LiveCounts="@_brandLiveCounts"
                       IsLiveFallback="@_brandLiveFallback"
                       PendingThreshold="20" />
</div>

@* ── Incidentes ── *@
@{
    bool hayCriticos = _openIncidents.Any(i => i.Severity == Severity.Critical);
}

@if (_incidentsFallback)
{
    var criticals = CheckStore.Results
        .Where(kv => kv.Value.Status != CheckStatus.Ok)
        .OrderByDescending(kv => kv.Value.Status).ToList();
    <div style="background:#1e1e2e; border-radius:12px; padding:1rem;">
        <h4 style="color:#eab308; font-size:1.1rem; font-weight:600; margin-bottom:0.6rem;">
            ⚠ BD no disponible — últimos estados conocidos
        </h4>
        @foreach (var kv in criticals)
        {
            var sc = kv.Value.Status == CheckStatus.Critical ? "#ef4444" : "#eab308";
            <div style="border-left:4px solid @sc; padding:0.4rem 0.8rem; margin-bottom:0.4rem;
                        background:rgba(255,255,255,0.04); border-radius:4px;
                        display:flex; justify-content:space-between;">
                <span style="color:#e0e0e0;">@ModuleLabel(kv.Key)</span>
                <span style="color:@sc; font-weight:700;">@(kv.Value.Status == CheckStatus.Critical ? "CRITICAL" : "WARN")</span>
            </div>
        }
    </div>
}
else if (_openIncidents.Any())
{
    <div style="background:#1e1e2e; border-radius:12px; padding:1rem;">
        <h4 style="color:#fff; font-size:1.1rem; font-weight:600; margin-bottom:0.6rem;">
            @if (hayCriticos) { <span style="color:#ef4444;">🔴</span> }
            else              { <span style="color:#eab308;">🟡</span> }
            Incidentes Activos (@_openIncidents.Count)
        </h4>
        <div style="display:flex; flex-direction:column; gap:0.4rem;">
            @foreach (var inc in _openIncidents)
            {
                var sc = inc.Severity == Severity.Critical ? "#ef4444" : "#eab308";
                <div style="border-left:4px solid @sc; padding:0.5rem 0.8rem;
                            background:rgba(255,255,255,0.04); border-radius:6px;
                            display:flex; justify-content:space-between; align-items:center; gap:1rem;">
                    <div style="min-width:0;">
                        <div style="font-weight:500; color:#e0e0e0;">@ModuleLabel(inc.Module)</div>
                        @if (inc.Alert?.QuePaso is not null)
                        {
                            <div style="font-size:0.75rem; color:#9ca3af; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                @Truncate(inc.Alert.QuePaso, 60)
                            </div>
                        }
                    </div>
                    <span style="color:@sc; font-weight:700; font-size:0.9rem; white-space:nowrap; flex-shrink:0;">
                        @inc.Severity
                    </span>
                </div>
            }
        </div>
    </div>
}
else
{
    <div style="background:#1e1e2e; border-radius:12px; padding:0.7rem 1rem; text-align:center;">
        <span style="color:#22c55e; font-size:1.1rem; font-weight:600;">✓ Sin incidentes activos</span>
    </div>
}

@code {
    private List<ChannelItem>? _channels;
    private IReadOnlyList<JobStatusSnapshot>? _jobs;
    private IReadOnlyList<BrandSnapshot>      _brandSnapshots    = [];
    private IReadOnlyDictionary<string, int>? _brandLiveCounts   = null;
    private bool                              _brandLiveFallback = false;
    private List<Incident>                    _openIncidents     = [];
    private bool                              _incidentsFallback = false;
    private Func<AlertMessage, Task>?         _alertHandler;
    private Func<Guid, Task>?                 _closeHandler;
    private Timer?                            _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _alertHandler = async _ =>
        {
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("startTitleAlert");
        };
        _closeHandler = async _ =>
        {
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
            if (!_openIncidents.Any(i => i.Severity == Severity.Critical))
                await JS.InvokeVoidAsync("stopTitleAlert");
        };
        Broadcaster.OnAlert          += _alertHandler;
        Broadcaster.OnIncidentClosed += _closeHandler;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return Task.CompletedTask;
        _refreshTimer = new Timer(async _ => await InvokeAsync(RefreshAsync), null,
            TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(15));
        return Task.CompletedTask;
    }

    private async Task RefreshAsync()
    {
        try
        {
            _brandSnapshots    = await BrandSnapshotRepo.GetLatestPerSiteAsync();
            _brandLiveFallback = false;
            _brandLiveCounts   = null;
        }
        catch
        {
            _brandLiveCounts   = ParseBrandCountsFromLastCheckStore();
            _brandLiveFallback = _brandLiveCounts is not null;
        }
        try { _jobs = await JobSource.GetCurrentStatusAsync(); } catch { }

        if (CheckStore.Results.TryGetValue(ModuleId.DbOrderChecker, out var orderResult))
            _channels = ParseChannelDetails(orderResult.Details);
        else
            _channels = null;

        try
        {
            var paged = await IncidentService.SearchHistoryAsync(
                new IncidentSearchFilter(Take: 50), default);
            _openIncidents     = paged.Items.Where(i => i.ClosedAt is null)
                .OrderByDescending(i => i.OpenedAt).ToList();
            _incidentsFallback = false;
        }
        catch { _incidentsFallback = true; }

        await InvokeAsync(StateHasChanged);
    }

    private string ElapsedLabel(ModuleId id)
    {
        if (!CheckStore.Results.TryGetValue(id, out var r)) return "—";
        var elapsed = DateTimeOffset.UtcNow - r.CheckedAt;
        if (elapsed.TotalMinutes >= 1)
            return $"hace {(int)elapsed.TotalMinutes}m";
        return $"hace {(int)elapsed.TotalSeconds}s";
    }

    private RenderFragment TimingChip(string label, ModuleId id) => builder =>
    {
        var hasResult = CheckStore.Results.TryGetValue(id, out var r);
        var elapsed   = hasResult ? ElapsedLabel(id) : "—";
        var status    = hasResult ? r!.Status : (CheckStatus?)null;
        var dotColor  = status switch
        {
            CheckStatus.Ok       => "#22c55e",
            CheckStatus.Warn     => "#eab308",
            CheckStatus.Critical => "#ef4444",
            _                    => "#6b7280"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "style",
            "display:inline-flex; align-items:center; gap:0.35rem; " +
            "background:rgba(255,255,255,0.06); border-radius:6px; " +
            "padding:0.2rem 0.6rem; color:#9ca3af;");
        builder.OpenElement(2, "span");
        builder.AddAttribute(3, "style",
            $"width:8px; height:8px; border-radius:50%; background:{dotColor}; flex-shrink:0;");
        builder.CloseElement();
        builder.OpenElement(4, "span");
        builder.AddAttribute(5, "style", "color:#9ca3af;");
        builder.AddContent(6, label + ": ");
        builder.CloseElement();
        builder.OpenElement(7, "strong");
        builder.AddAttribute(8, "style", "color:#e0e0e0;");
        builder.AddContent(9, elapsed);
        builder.CloseElement();
        builder.CloseElement();
    };

    private IReadOnlyDictionary<string, int>? ParseBrandCountsFromLastCheckStore()
    {
        if (!CheckStore.Results.TryGetValue(ModuleId.BrandMonitor, out var r)) return null;
        if (string.IsNullOrWhiteSpace(r.Details)) return null;
        var result = new Dictionary<string, int>();
        foreach (var part in r.Details.Split('|', StringSplitOptions.RemoveEmptyEntries))
        {
            var seg = part.Split(':');
            if (seg.Length >= 2 && int.TryParse(seg[1], out var count))
                result[seg[0]] = count;
        }
        return result.Count > 0 ? result : null;
    }

    private CheckStatus? GetModuleStatus(ModuleId id)
        => CheckStore.Results.TryGetValue(id, out var r) ? r.Status : null;

    private CheckStatus? GetApisStatus()
    {
        var sf = GetModuleStatus(ModuleId.SalesforceApi);
        var mv = GetModuleStatus(ModuleId.MultivendeApi);
        if (sf == CheckStatus.Critical || mv == CheckStatus.Critical) return CheckStatus.Critical;
        if (sf == CheckStatus.Warn     || mv == CheckStatus.Warn)     return CheckStatus.Warn;
        if (sf == null || mv == null) return null;
        return CheckStatus.Ok;
    }

    private string GetLatency()
    {
        if (CheckStore.Results.TryGetValue(ModuleId.DbHealthChecker, out var r)
            && !string.IsNullOrEmpty(r.Details))
            return r.Details;
        return "N/A";
    }

    private string? GetApiShortDetail(ModuleId id)
    {
        if (!CheckStore.Results.TryGetValue(id, out var r)) return null;
        if (r.Status == CheckStatus.Ok || string.IsNullOrEmpty(r.Details)) return null;
        return r.Details.Length > 40 ? r.Details[..40] + "…" : r.Details;
    }

    private RenderFragment ApiStatusBadge(ModuleId id) => builder =>
    {
        var status = GetModuleStatus(id);
        var color  = status switch
        {
            CheckStatus.Ok       => "#22c55e",
            CheckStatus.Warn     => "#eab308",
            CheckStatus.Critical => "#ef4444",
            _                    => "#6b7280"
        };
        var label = status switch
        {
            CheckStatus.Ok       => "Disponible",
            CheckStatus.Warn     => "Advertencia",
            CheckStatus.Critical => "Sin respuesta",
            _                    => "Sin datos"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "style", $"color:{color}; font-weight:700;");
        builder.AddContent(2, label);
        builder.CloseElement();
    };

    private static List<ChannelItem>? ParseChannelDetails(string details)
    {
        if (string.IsNullOrEmpty(details)) return null;
        var parts = details.Split('|', StringSplitOptions.RemoveEmptyEntries);
        var items = new List<ChannelItem>();
        foreach (var part in parts)
        {
            var seg = part.Split(':');
            if (seg.Length >= 3 && int.TryParse(seg[1], out var count))
                items.Add(new ChannelItem(seg[0], count, seg[2] == "OK"));
        }
        return items.Count > 0 ? items : null;
    }

    private static string ModuleLabel(ModuleId m) => m switch
    {
        ModuleId.DbOrderChecker  => "BD Pedidos",
        ModuleId.DbHealthChecker => "BD Salud",
        ModuleId.JobsMonitor     => "Jobs",
        ModuleId.SalesforceApi   => "Salesforce API",
        ModuleId.MultivendeApi   => "Multivende API",
        ModuleId.BrandMonitor    => "Brand Monitor",
        _                        => m.ToString()
    };

    private static string Truncate(string s, int max)
        => s.Length <= max ? s : s[..max] + "…";

    public async ValueTask DisposeAsync()
    {
        if (_alertHandler is not null) Broadcaster.OnAlert          -= _alertHandler;
        if (_closeHandler is not null) Broadcaster.OnIncidentClosed -= _closeHandler;
        if (_refreshTimer is not null) await _refreshTimer.DisposeAsync();
    }

    private sealed record ChannelItem(string Name, int Count, bool IsOk);
}
