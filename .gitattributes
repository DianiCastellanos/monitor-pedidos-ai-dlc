# Auto-detect text files and normalize line endings
* text=auto

# Force LF for markdown and scripts
*.md text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.razor text eol=crlf
*.html text eol=crlf
*.css text eol=crlf
*.js text eol=crlf
